+# Current layout, as recommended in the README. Used by test/smoke-test.sh.
+server:
+    interface: 0.0.0.0
+    access-control: 0.0.0.0/0 allow   # the test publishes the port on 127.0.0.1 only
+    do-ip6: no                          # GitHub-hosted runners have no IPv6
+    chroot: ""
+    auto-trust-anchor-file: "/var/lib/unbound/root.key"
+    verbosity: 1
